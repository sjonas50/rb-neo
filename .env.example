# Copy to .env and adjust. .env is gitignored; never commit real secrets.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rbneopass

# Path to the directory of <word>.json files.
RB_WORDS_DIR=words

# Optional LLM layer (Phase 4 / showcase). Without a key, lessons fall back to a
# deterministic offline preview so the demo still runs. Set this for LIVE Claude
# generation in the Streamlit showcase.
ANTHROPIC_API_KEY=
# Model id for the recommendation/lesson layer (default shown). Sonnet 4.6 gives
# richer showcase lessons; use claude-haiku-4-5 for lower cost/latency at scale.
ANTHROPIC_MODEL=claude-sonnet-4-6
